Vagrant.configure("2") do |config|
  # VMs OS
  config.vm.box = "debian/trixie64"

  server_ip = "192.168.56.110"

  # VMs configuration
  config.vm.provider "libvirt" do |libvirt|
    libvirt.driver = "qemu"
    libvirt.cpus = 2
    libvirt.memory = 2048
  end

  # VM dependencies
  config.vm.define "afabyS" do |v|
    v.vm.hostname = "afabyS"
    v.vm.network "private_network", ip: server_ip
    v.vm.provision "shell", inline: <<-SHELL
      sudo apt update -y
      sudo apt install curl make ca-certificates -y
      sudo install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      sudo chmod a+r /etc/apt/keyrings/docker.asc
      sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
      sudo apt update -y
      sudo apt install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin -y
      curl -sfL https://get.k3s.io | INSTALLATION_K3S_EXEC="server --node-ip #{server_ip}" sh -s - --tls-san #{server_ip}
      sudo sed -i "s/127.0.0.1/#{server_ip}/" /etc/rancher/k3s/k3s.yaml
      cd /vagrant
      sudo docker compose up
    SHELL
  end
end
